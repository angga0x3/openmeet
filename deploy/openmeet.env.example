# Copy to /etc/openmeet/openmeet.env (mode 0600). Never commit real secrets.

# Scheduling database (Neon pooled connection string).
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/openmeet?sslmode=require

# LiveKit SFU. Without this block media uses the peer-to-peer mesh.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional limits
OPENMEET_MAX_PARTICIPANTS=25
